# Production — set in Vercel Production environment variables only.
# Use your PRODUCTION Supabase project.
# See docs/environments.md and docs/deployment-checklist.md

APP_ENV=production

NEXT_PUBLIC_SUPABASE_URL=https://your-production-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

NEXT_PUBLIC_APP_URL=https://app.your-domain.com

GOOGLE_CLIENT_ID=your-production-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-production-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://app.your-domain.com/api/integrations/google/callback
TOKEN_ENCRYPTION_SECRET=your-production-encryption-secret-min-32-chars

# Email — Resend (outbound) + inbound webhook for inbox replies
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=CapitalOS <no-reply@mail.your-domain.com>
INBOUND_EMAIL_DOMAIN=mail.your-domain.com
INBOUND_WEBHOOK_SECRET=your-inbound-webhook-shared-secret

# Cron (Vercel) — required for orchestration, digests, and meeting reminders
CRON_SECRET=your-production-cron-shared-secret

# Optional
# DATABASE_URL=postgresql://...   # required for npm run ops:backup-db
# ANTHROPIC_API_KEY=sk-ant-...   # Claude AI
# WHEREBY_API_KEY=               # iCFO Events live video (optional — without it, sessions use uploaded recordings)
# NEXT_PUBLIC_FOUNDER_NAV_V2=on  # Serve the consolidated 4-step founder nav (unset = current nav). Reversible.

# Zoom Meeting SDK — Talk Show embedded live video (optional). Without these, the
# Talk Show falls back to a "Join Zoom" link. Create a General app in the Zoom
# Marketplace, enable Meeting SDK under the Embed tab, use its Client ID + Secret.
# Docs: https://developers.zoom.us/docs/meeting-sdk/auth/
# NEXT_PUBLIC_ZOOM_MEETING_SDK=true                  # turn the embedded stage on
# ZOOM_MEETING_SDK_CLIENT_ID=your-client-id
# ZOOM_MEETING_SDK_CLIENT_SECRET=your-client-secret  # server-only; never expose
# ZOOM_TALKSHOW_MEETING_NUMBER=2613180099            # meeting to embed (digits only)
# ZOOM_TALKSHOW_MEETING_PASSCODE=                    # meeting passcode, if any
