{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase migration up:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)"
    ],
    "ask": [
      "Edit(src/**)",
      "Write(src/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
